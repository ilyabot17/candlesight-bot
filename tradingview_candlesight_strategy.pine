//@version=5
strategy("CandleSight AI — Institutional Trend & Trap Strategy v3", 
         overlay=true, 
         initial_capital=10000, 
         currency=currency.USD,
         default_qty_type=strategy.fixed, 
         default_qty_value=1, 
         commission_type=strategy.commission.cash_per_contract, 
         commission_value=2.0,
         slippage=1,
         max_bars_back=500)

// =============================================================================
// CANDLESIGHT AI — INSTITUTIONAL TREND & TRAP STRATEGY v3
// Solves the "Falling Knife" Trap:
// 1. TREND ALIGNMENT SHIELD:
//    - When market is in a DOWNTREND (EMA 9 < VWAP): ALL BUY SIGNALS ARE FORBIDDEN.
//      Only take SNIPE SHORT when price rallies into resistance and gets rejected.
//    - When market is in an UPTREND (EMA 9 > VWAP): ALL SHORT SIGNALS ARE FORBIDDEN.
//      Only take SNIPE BUY when price pulls back into support and bounces.
// 2. High-volume US Session Only (avoiding midday lunch dead-zone)
// 3. Native strategy.exit() orders with fixed 1:2.0 R:R
// =============================================================================

// --- Inputs ---
grp_risk = "Risk & Target Management"
fixed_qty = input.int(1, "Contracts / Lots per Trade", minval=1, group=grp_risk)
rr_ratio = input.float(2.0, "Risk-to-Reward Ratio (TP Multiplier)", minval=1.0, step=0.5, group=grp_risk)

grp_trap = "Institutional Liquidity Snipers"
lookback_sweep = input.int(12, "Liquidity Sweep Lookback Bars", minval=5, maxval=30, group=grp_trap)
wick_ratio = input.float(1.2, "Exhaustion Wick to Body Ratio", minval=1.0, step=0.1, group=grp_trap)

grp_time = "Session Filter (US High Volume Hours)"
use_session = input.bool(true, "Trade Only Active US Session", group=grp_time)
session_str = input.session("0930-1600:23456", "Active Hours (EST)", group=grp_time)
avoid_lunch = input.bool(true, "Avoid Midday Lunch Dead-Zone (11:30-13:00 EST)", group=grp_time)
lunch_str = input.session("1130-1300:23456", "Lunch Dead-Zone", group=grp_time)

// --- Indicator Calculations ---
ema9 = ta.ema(close, 9)
vwapVal = ta.vwap(hlc3)
atrVal = ta.atr(14)

// Candle Metrics
candleBody = math.abs(close - open)
upperWick = high - math.max(open, close)
lowerWick = math.min(open, close) - low
isGreen = close > open
isRed = close < open

// Session Window Check
inSession = not use_session or not na(time(timeframe.period, session_str, "America/New_York"))
inLunch = avoid_lunch and not na(time(timeframe.period, lunch_str, "America/New_York"))
validTradingTime = inSession and not inLunch

// =============================================================================
// MACRO TREND REGIME (NEVER TRADE AGAINST INSTITUTIONAL DIRECTION)
// =============================================================================
isMacroBull = ema9 > vwapVal and close > vwapVal
isMacroBear = ema9 < vwapVal and close < vwapVal

// =============================================================================
// INSTITUTIONAL TRAP DETECTION (WITH TREND SHIELD)
// =============================================================================

// 1. SHORT TRAP (Only allowed in Macro Bear downtrend or clean VWAP rejection)
// Price rallies back up to test EMA 9/VWAP, sweeps recent high, prints upper wick, dumps red
prevHigh = ta.highest(high[1], lookback_sweep)
topSweep = high >= prevHigh and upperWick >= (candleBody * wick_ratio)
isTopTrap = isMacroBear and topSweep and isRed and validTradingTime

// 2. BUY TRAP (Only allowed in Macro Bull uptrend or clean VWAP bounce)
// Price dips back down to test EMA 9/VWAP, sweeps recent low, prints lower wick, bounces green
prevLow = ta.lowest(low[1], lookback_sweep)
bottomSweep = low <= prevLow and lowerWick >= (candleBody * wick_ratio)
isBottomTrap = isMacroBull and bottomSweep and isGreen and validTradingTime

// =============================================================================
// NATIVE STRATEGY EXECUTION
// =============================================================================

if (strategy.position_size == 0)
    if isTopTrap
        slPrice = high + (0.3 * atrVal)
        riskDist = math.abs(slPrice - close)
        tpPrice = close - (riskDist * rr_ratio)
        
        strategy.entry("Trap Short", strategy.short, qty=fixed_qty, comment="🛑 TREND SHORT")
        strategy.exit("Exit Short", "Trap Short", stop=slPrice, limit=tpPrice, 
                      comment_loss="❌ SL", comment_profit="🎯 TP")
        
    else if isBottomTrap
        slPrice = low - (0.3 * atrVal)
        riskDist = math.abs(close - slPrice)
        tpPrice = close + (riskDist * rr_ratio)
        
        strategy.entry("Trap Long", strategy.long, qty=fixed_qty, comment="🟢 TREND BUY")
        strategy.exit("Exit Long", "Trap Long", stop=slPrice, limit=tpPrice, 
                      comment_loss="❌ SL", comment_profit="🎯 TP")

// =============================================================================
// CHART VISUALIZATIONS
// =============================================================================

plot(vwapVal, "Institutional VWAP", color=color.new(#eab308, 0), linewidth=2)
plot(ema9, "Fast EMA 9", color=color.new(#00bfff, 0), linewidth=2)

plotshape(isTopTrap, title="Short Signal", style=shape.labeldown, location=location.abovebar, 
          color=color.red, text="SHORT", textcolor=color.white, size=size.normal)

plotshape(isBottomTrap, title="Buy Signal", style=shape.labelup, location=location.belowbar, 
          color=color.green, text="BUY", textcolor=color.white, size=size.normal)
