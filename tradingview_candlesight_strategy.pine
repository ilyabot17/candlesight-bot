//@version=5
strategy("CandleSight AI — Institutional Master Strategy (v5/v6 Confluence)", 
         overlay=true, 
         initial_capital=10000, 
         currency=currency.USD,
         default_qty_type=strategy.fixed, 
         default_qty_value=1, 
         commission_type=strategy.commission.cash_per_contract, 
         commission_value=2.0,
         slippage=1,
         max_bars_back=500)

// =============================================================================
// CANDLESIGHT AI — MASTER STRATEGY (V5/V6 GOLDEN CONFLUENCE)
// Restores the proven core from our highest-success v5/v6 paper testing:
// 1. 15-Minute Macro Filter: request.security() checks 15m 50 EMA (kills counter-trend noise)
// 2. 3-Ribbon Alignment: Fast EMA 9 > Trend EMA 21 > Macro Baseline EMA 50
// 3. MACD Momentum Trigger: ta.crossover(macdLine, signalLine)
// 4. Session Protection: US Hours Only (09:30-16:00 EST), skipping Lunch Dead-Zone
// 5. Native Stop Loss (1.5 ATR) & Take Profit (1:2.0 R:R)
// =============================================================================

// --- Inputs ---
grp_risk = "Risk & Target Management"
fixed_qty = input.int(1, "Contracts / Lots per Trade", minval=1, group=grp_risk)
rr_ratio = input.float(2.0, "Risk-to-Reward Ratio (TP Multiplier)", minval=1.0, step=0.5, group=grp_risk)
atr_sl_mult = input.float(1.5, "Stop Loss ATR Multiplier", minval=1.0, step=0.1, group=grp_risk)

grp_ribbon = "Ribbon Settings (v5/v6 Foundation)"
len_fast = input.int(9, "Fast EMA", group=grp_ribbon)
len_slow = input.int(21, "Trend EMA", group=grp_ribbon)
len_macro = input.int(50, "Macro Baseline EMA", group=grp_ribbon)

grp_htf = "Higher Timeframe Filter (The Noise Killer)"
use_htf = input.bool(true, "Enable 15M Macro Filter", group=grp_htf)
htf_timeframe = input.timeframe("15", "Macro Timeframe", group=grp_htf)

grp_time = "Session Filter (US High Volume Hours)"
use_session = input.bool(true, "Trade Only Active US Session", group=grp_time)
session_str = input.session("0930-1600:23456", "Active Hours (EST)", group=grp_time)
avoid_lunch = input.bool(true, "Avoid Midday Lunch Dead-Zone (11:30-13:00 EST)", group=grp_time)
lunch_str = input.session("1130-1300:23456", "Lunch Dead-Zone", group=grp_time)

// --- Calculations ---
ema9 = ta.ema(close, len_fast)
ema21 = ta.ema(close, len_slow)
ema50 = ta.ema(close, len_macro)
vwapVal = ta.vwap(hlc3)
atrVal = ta.atr(14)

// 15-Minute Macro Filter
htfEma50 = request.security(syminfo.tickerid, htf_timeframe, ta.ema(close, len_macro))
htfClose = request.security(syminfo.tickerid, htf_timeframe, close)
htfBull = not use_htf or (htfClose >= htfEma50)
htfBear = not use_htf or (htfClose <= htfEma50)

// MACD Momentum Engine (12, 26, 9)
[macdLine, signalLine, histLine] = ta.macd(close, 12, 26, 9)

// Session Window Check
inSession = not use_session or not na(time(timeframe.period, session_str, "America/New_York"))
inLunch = avoid_lunch and not na(time(timeframe.period, lunch_str, "America/New_York"))
validTradingTime = inSession and not inLunch

// =============================================================================
// V5/V6 STRICT 3-WAY INSTITUTIONAL CONFLUENCE SIGNALS
// =============================================================================

// BULL CONFLUENCE:
// 1. Price above 50 EMA & EMA 9 > EMA 21
// 2. 15-Minute Macro is Bullish
// 3. MACD crosses over bullishly OR EMA 9 crosses over EMA 21
validBullTrend = (close > ema50) and (ema9 > ema21) and htfBull
freshBuyTrigger = ta.crossover(macdLine, signalLine) or ta.crossover(ema9, ema21)
buySignal = validBullTrend and freshBuyTrigger and validTradingTime

// BEAR CONFLUENCE:
// 1. Price below 50 EMA & EMA 9 < EMA 21
// 2. 15-Minute Macro is Bearish
// 3. MACD crosses under bearishly OR EMA 9 crosses under EMA 21
validBearTrend = (close < ema50) and (ema9 < ema21) and htfBear
freshSellTrigger = ta.crossunder(macdLine, signalLine) or ta.crossunder(ema9, ema21)
sellSignal = validBearTrend and freshSellTrigger and validTradingTime

// =============================================================================
// NATIVE STRATEGY EXECUTION
// =============================================================================

if (strategy.position_size == 0)
    if buySignal
        slPrice = math.min(close - (atrVal * atr_sl_mult), ema50 - (atrVal * 0.5))
        riskDist = math.abs(close - slPrice)
        tpPrice = close + (riskDist * rr_ratio)
        
        strategy.entry("Master Long", strategy.long, qty=fixed_qty, comment="🟢 BUY / LONG")
        strategy.exit("Exit Long", "Master Long", stop=slPrice, limit=tpPrice, 
                      comment_loss="❌ SL", comment_profit="🎯 TP")
        
    else if sellSignal
        slPrice = math.max(close + (atrVal * atr_sl_mult), ema50 + (atrVal * 0.5))
        riskDist = math.abs(slPrice - close)
        tpPrice = close - (riskDist * rr_ratio)
        
        strategy.entry("Master Short", strategy.short, qty=fixed_qty, comment="🔴 SELL / SHORT")
        strategy.exit("Exit Short", "Master Short", stop=slPrice, limit=tpPrice, 
                      comment_loss="❌ SL", comment_profit="🎯 TP")

// =============================================================================
// CHART VISUALIZATIONS
// =============================================================================

plot(ema9, "Fast EMA 9", color=color.new(#06b6d4, 0), linewidth=1)
plot(ema21, "Trend EMA 21", color=color.new(#f59e0b, 0), linewidth=2)
plot(ema50, "Macro Baseline 50", color=color.new(#8b5cf6, 0), linewidth=2)
plot(vwapVal, "Session VWAP", color=color.new(#eab308, 0), linewidth=1)

plotshape(buySignal, title="Buy Signal", style=shape.labelup, location=location.belowbar, 
          color=#10b981, text="BUY", textcolor=color.white, size=size.normal)

plotshape(sellSignal, title="Sell Signal", style=shape.labeldown, location=location.abovebar, 
          color=#f43f5e, text="SHORT", textcolor=color.white, size=size.normal)
